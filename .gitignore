__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/
.DS_Store
~$*

# Reproducible downloaded data and split exports.
/datasets/raw/*.csv.gz
/datasets/processed/development.csv
/datasets/processed/test.csv
/datasets/processed/development_folds.csv

# Reproducible baseline models and per-customer development outputs.
/results/baselines/*.joblib
/results/baselines/oof_predictions.csv
/results/baselines/policy_assignments.csv

# Reproducible held-out models and per-customer artifacts.
/results/evaluation/*.joblib
/results/evaluation/test_assignments.csv
/results/evaluation/test_predictions.csv
